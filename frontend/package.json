{
  "name": "@gala-ticketing/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 1411",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 1411",
    "lint": "oxlint src vite.config.ts --deny-warnings",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b --pretty false",
    "test": "node --test"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.0",
    "@zxing/browser": "^0.1.5",
    "@zxing/library": "^0.21.3",
