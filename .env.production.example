NODE_ENV=production

# Public web origin
FRONTEND_ORIGIN=https://sacmautuoitre.io.vn
CORS_ALLOWED_ORIGINS=https://sacmautuoitre.io.vn

# PostgreSQL - replace every credential before deployment
POSTGRES_DB=gala_ticketing
POSTGRES_USER=gala_app
POSTGRES_PASSWORD=replace-with-a-strong-production-password
POSTGRES_PORT=1611
DATABASE_URL=postgresql://gala_app:replace-with-a-strong-production-password@postgres:5432/gala_ticketing
DATABASE_SSL=false

# Session
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_COOKIE_NAME=gala.sid
SESSION_COOKIE_SECURE=true

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://sacmautuoitre.io.vn/api/auth/google/callback
ADMIN_EMAILS=admin@example.com

# Payments
PAYMENTS_ENABLED=false
PAY2S_WEBHOOK_TOKEN=
PAY2S_VIETQR_URL=https://api.pay2s.vn/vietqr/generate
PAYMENT_BANK_CODE=MB
PAYMENT_ACCOUNT_NUMBER=
PAYMENT_ACCOUNT_NAME=

# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Keep previous production keys in the comma-separated ring when rotating.
TICKET_QR_ACTIVE_KEY_ID=prod-2026-v1
TICKET_QR_KEYS=prod-2026-v1:replace-with-a-base64url-encoded-32-byte-key

# Seed values, applied only when the seed command is invoked manually.
SEED_EVENT_NAME=GALA Sắc màu tuổi trẻ
SEED_EVENT_SUBTITLE=Gây quỹ học bổng Cùng bạn đến trường
SEED_EVENT_VENUE=Trường THPT Nguyễn Trãi - Bình Dương
SEED_EVENT_STARTS_AT=2026-11-14T18:00:00+07:00
SEED_TICKET_PRICE_VND=35000
SEED_TOTAL_CAPACITY=3500
SEED_MIN_TICKETS_PER_ORDER=1
SEED_MAX_TICKETS_PER_ORDER=100
SEED_SALES_START_AT=2026-10-01T00:00:00+07:00
SEED_SALES_END_AT=2026-11-14T17:30:00+07:00
SEED_RESERVATION_MINUTES=5

# Production frontend calls the API through the same-origin reverse proxy.
VITE_API_BASE_URL=/api
