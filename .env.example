NODE_ENV=development

# Web
FRONTEND_ORIGIN=http://localhost:1411
CORS_ALLOWED_ORIGINS=http://localhost:1411

# PostgreSQL
POSTGRES_DB=gala_ticketing
POSTGRES_USER=gala_app
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=1611
DATABASE_URL=postgresql://gala_app:replace-with-a-local-password@localhost:1611/gala_ticketing
# Integration tests create and remove an isolated schema in this database.
TEST_DATABASE_URL=postgresql://gala_app:replace-with-a-local-password@localhost:1611/gala_ticketing
DATABASE_SSL=false

# Session
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_COOKIE_NAME=gala.sid
# Local development runs over HTTP.
SESSION_COOKIE_SECURE=false

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:1511/api/auth/google/callback

# Admin access (comma-separated verified Google emails)
ADMIN_EMAILS=ngtruongmetin@gmail.com

# false: phát hành vé ngay khi đặt; true: giữ đơn để chờ thanh toán.
PAYMENTS_ENABLED=false
EXPIRATION_SWEEP_SECONDS=10
ALLOW_TRANSACTION_DATA_RESET=false

# Pay2S user webhook + VietQR. Required when PAYMENTS_ENABLED=true.
PAY2S_WEBHOOK_TOKEN=
PAY2S_VIETQR_URL=https://api.pay2s.vn/vietqr/generate
PAYMENT_BANK_CODE=MB
PAYMENT_ACCOUNT_NUMBER=
PAYMENT_ACCOUNT_NAME=

# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Keep previous keys in this comma-separated key ring when rotating.
TICKET_QR_ACTIVE_KEY_ID=local-v1
TICKET_QR_KEYS=local-v1:replace-with-a-base64url-encoded-32-byte-key

# Used only by the manually invoked seed command.
SEED_EVENT_NAME=GALA Sắc màu tuổi trẻ
SEED_EVENT_SUBTITLE=Gây quỹ học bổng Cùng bạn đến trường
SEED_EVENT_VENUE=Trường THPT Nguyễn Trãi - Bình Dương
SEED_EVENT_STARTS_AT=2026-11-14T18:00:00+07:00
SEED_TICKET_PRICE_VND=35000
SEED_TOTAL_CAPACITY=3500
SEED_MIN_TICKETS_PER_ORDER=1
SEED_MAX_TICKETS_PER_ORDER=100
SEED_SALES_START_AT=2026-10-01T00:00:00+07:00
SEED_SALES_END_AT=2026-11-14T17:30:00+07:00
SEED_RESERVATION_MINUTES=5

# Frontend defaults to /api locally and uses the Vite proxy.
VITE_API_BASE_URL=/api
VITE_DEV_API_PROXY_TARGET=http://localhost:1511
